---
// Slash-nav header — five spheres · divider · About / Contact / Pricing.
interface Props {
  path: string;
}
const { path } = Astro.props;
const links = [
  { href: "/church", label: "Church" },
  { href: "/state", label: "State" },
  { href: "/market", label: "Market" },
  { href: "/family", label: "Family" },
  { href: "/individual", label: "Individual" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
  { href: "/pricing", label: "Pricing" },
];
---

<header class="site-header">
  <div class="site-header__row">
    <a href="/" class="wordmark">The&nbsp;Oracles</a>
    <nav class="slash-nav" aria-label="Primary">
      {
        links.map((l) =>
          l.href === path ? (
            <a href={l.href} aria-current="page">
              <span class="nav-label">{l.label}</span>
            </a>
          ) : (
            <a href={l.href}>
              <span class="nav-label">{l.label}</span>
            </a>
          )
        )
      }
    </nav>
    <div class="year-marker"><span class="bracket-count">MMXXVI</span></div>
  </div>
</header>
