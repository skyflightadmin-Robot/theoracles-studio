---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollQuoteScript from "../components/ScrollQuoteScript.astro";
---

<BaseLayout
  title="Family — Foundation of Society · The Oracles"
  description="Weddings, legacy and heritage films, family story, and the family home — the household and its lineage, told with care."
  path="/family"
>
  <section class="vhero">
    <p class="eyebrow"><span class="num">04</span> &nbsp; Family</p>
    <h1 class="vhero__title">The story a<br />home <span class="accent">carries.</span></h1>
    <p class="law-line">Foundation of Society</p>
    <p class="vhero__sub">
      The home is where the law is first practiced and the story is first formed.
      Here is where we shape, mold, and nurture the next generation. Let&rsquo;s
      tell stories that build for generations because they&rsquo;re rooted in
      God&rsquo;s unchanging law.
    </p>
    <p class="sphere-block__work" style="margin-top:1.5rem;">Weddings · protect life · education</p>
  </section>

  <section class="section rule-top">
    <p class="eyebrow">Selected work</p>
    <div class="grid-work">
      <article>
        <div class="tile__frame">[ Video · coming soon ]</div>
        <div class="tile__meta">
          <h3 class="tile__title">Film 01</h3>
          <p class="tile__credit">Dir. Dabraham · DP/Editor Aaron · Commissioned by Urban Skye</p>
        </div>
        <!-- Add the YouTube link/embed here when live -->
      </article>
    </div>
  </section>

  <section class="section rule-top">
    <figure class="pullquote scroll-quote">
      <blockquote>&ldquo;The team did a great job of creating a story on film that captures the heartbeat of our ministry.&rdquo;</blockquote>
      <figcaption>&mdash; Matt Vlahovich, Headmaster &middot; Reign Christian Academy</figcaption>
    </figure>
    <a href="/contact" class="btn"><span>/ Tell your family&rsquo;s story</span><span aria-hidden="true">&rarr;</span></a>
  </section>

  <ScrollQuoteScript />
</BaseLayout>
