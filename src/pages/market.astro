---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Market — A Collective Garden · The Oracles"
  description="Business and brand films, commercial real estate, and drone mapping, inspections, and progress work — the SkyFlight craft under the Oracles."
  path="/market"
>
  <section class="vhero">
    <p class="eyebrow"><span class="num">03</span> &nbsp; Market</p>
    <h1 class="vhero__title">Your story<br />goes <span class="accent">here.</span></h1>
    <p class="law-line">A Collective Garden</p>
    <p class="vhero__sub">
      Be the first story we tell, and you&rsquo;ll receive the same treatment for
      half the price.
    </p>
  </section>

  <section class="section rule-top">
    <a href="/contact" class="btn" style="margin-top:0;"><span>/ Tell your story</span><span aria-hidden="true">&rarr;</span></a>
    <div style="margin-top:2rem;">
      <a href="/state" class="link-slash" style="margin-top:0;">/ See our work</a>
    </div>
  </section>
</BaseLayout>
