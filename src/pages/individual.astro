---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Individual — Self Government · The Oracles"
  description="Founder and candidate portraits, personal brand, memoir and testimony — character and conscience, the story you're living."
  path="/individual"
>
  <section class="vhero">
    <p class="eyebrow"><span class="num">05</span> &nbsp; Individual</p>
    <h1 class="vhero__title">The person,<br />on the <span class="accent">record.</span></h1>
    <p class="law-line">Self Government</p>
    <p class="vhero__sub">
      Everything else begins with a person learning to govern themselves. Stories
      that give us structure and direction are designed to see the self flourish.
    </p>
    <p class="sphere-block__work" style="margin-top:1.5rem;">Portraits · personal brand · testimony</p>
  </section>

  <section class="section rule-top">
    <p class="eyebrow">Selected work</p>
    <div class="grid-work">
      <article>
        <div class="tile__embed">
          <iframe
            src="https://www.youtube-nocookie.com/embed/h3JXcUzfK8Y"
            title="Pastor's Monday — Colorado Chapter"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
        </div>
        <div class="tile__meta">
          <h3 class="tile__title">Pastor&rsquo;s Monday — Colorado Chapter</h3>
          <p class="tile__credit">Dir. Dabraham · DP/Editor Aaron</p>
        </div>
      </article>
      <article>
        <div class="tile__frame">[ Video · coming soon ]</div>
        <div class="tile__meta">
          <h3 class="tile__title">Film 02</h3>
          <p class="tile__credit">Dir. Dabraham · DP/Editor Aaron</p>
        </div>
        <!-- Add the YouTube link/embed here when live -->
      </article>
      <article>
        <div class="tile__frame">[ Video · coming soon ]</div>
        <div class="tile__meta">
          <h3 class="tile__title">Film 03</h3>
          <p class="tile__credit">Dir. Dabraham · DP/Editor Aaron</p>
        </div>
        <!-- Add the YouTube link/embed here when live -->
      </article>
    </div>
  </section>

  <section class="section rule-top">
    <a href="/contact" class="btn" style="margin-top:0;"><span>/ Tell your story</span><span aria-hidden="true">&rarr;</span></a>
  </section>
</BaseLayout>
