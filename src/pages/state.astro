---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="State — We the People · The Oracles"
  description="Campaign films, ad spots, and issue documentaries grounded in order, justice, and the public good."
  path="/state"
>
  <section class="vhero">
    <p class="eyebrow"><span class="num">02</span> &nbsp; State</p>
    <h1 class="vhero__title">By the people,<br />for the <span class="accent">people.</span></h1>
    <p class="law-line">We the People</p>
    <p class="vhero__sub">
      Adams said, &ldquo;Our Constitution was made only for a moral and religious
      people. It is wholly inadequate to the government of any other.&rdquo;
      Without good stories, we don&rsquo;t keep our republic.
    </p>
    <p class="sphere-block__work" style="margin-top:1.5rem;">Campaign films · civic · issue docs</p>
  </section>

  <section class="section rule-top">
    <p class="eyebrow">Selected work</p>
    <div class="grid-work">
      <article>
        <div class="tile__embed">
          <iframe
            src="https://www.youtube-nocookie.com/embed/yFSo1prthM0"
            title="Political Ads — Lynda Zamora Wilson"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
        </div>
        <div class="tile__meta">
          <h3 class="tile__title">Political Ads — Lynda Zamora Wilson</h3>
          <p class="tile__credit">Dir. Dabraham · DP/Editor Aaron</p>
        </div>
      </article>
      <article>
        <div class="tile__embed">
          <iframe
            src="https://www.youtube-nocookie.com/embed/62k7b6TaEbU"
            title="Special Events — RMGO &quot;Save our Second&quot; Banquet"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
        </div>
        <div class="tile__meta">
          <h3 class="tile__title">Special Events — RMGO &ldquo;Save our Second&rdquo; Banquet</h3>
          <p class="tile__credit">Dir. Dabraham · DP/Editor Aaron</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section rule-top">
    <a href="/contact" class="btn" style="margin-top:0;"><span>/ Talk about your race</span><span aria-hidden="true">&rarr;</span></a>
  </section>
</BaseLayout>
