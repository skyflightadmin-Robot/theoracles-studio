---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollQuoteScript from "../components/ScrollQuoteScript.astro";
---

<BaseLayout
  title="Church — Redemption & Revelation · The Oracles"
  description="Film for the church: ministries, Christian schools, missions, and gatherings. The greatest story ever told, told like we believe it."
  path="/church"
>
  <section class="vhero">
    <p class="eyebrow"><span class="num">01</span> &nbsp; Church</p>
    <!-- max-width widened so this longer headline sets as the same 2-line lockup as the other spheres -->
    <h1 class="vhero__title" style="max-width:21ch;">The greatest story,<br />told like it <span class="accent">matters.</span></h1>
    <p class="law-line">Redemption &amp; Revelation</p>
    <p class="vhero__sub">
      God is always writing his story in and through the church. Where you fit
      and how you serve our King is your part of a much larger story. The Oracles
      can tell your part of the story because we love God&rsquo;s story.
    </p>
    <p class="sphere-block__work" style="margin-top:1.5rem;">Ministry films · fundraising videos · missions</p>
  </section>

  <section class="section rule-top">
    <p class="eyebrow">Selected work</p>
    <div class="grid-work">
      <article>
        <div class="tile__embed">
          <iframe
            src="https://www.youtube-nocookie.com/embed/zTyhAaXmdnw"
            title="2026 The Gathering — One Gospel"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
        </div>
        <div class="tile__meta">
          <h3 class="tile__title">The Gathering — One Gospel</h3>
          <p class="tile__credit">Dir. Dabraham · DP/Editor Aaron · Commissioned by Urban Skye</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section rule-top">
    <figure class="pullquote scroll-quote">
      <blockquote>&ldquo;Once again, this is excellent.&rdquo;</blockquote>
      <figcaption>&mdash; Shaun Garman, President &middot; One Gospel</figcaption>
    </figure>
    <a href="/contact" class="btn"><span>/ Start a film</span><span aria-hidden="true">&rarr;</span></a>
  </section>

  <ScrollQuoteScript />
</BaseLayout>
